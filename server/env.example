# Секреты сборщика secure.abramov.vip на сервере worker. Файл: /srv/secure/.env (права 600, в git не попадает).
# Значения — те же, что были в секретах репозитория GitHub (там их не прочитать — берём заново, см. server/README.md).

# Нейросеть. Лучше ОТДЕЛЬНЫЙ ключ Gemini (свой проект в AI Studio), не тот, что у ТУТ.DUS: бесплатные лимиты общие на проект.
GEMINI_API_KEY=
GEMINI_MODELS=
AI_DAILY_REQUESTS=100

# NVD (nvd.nist.gov/developers/request-an-api-key) — без ключа тоже работает, но медленнее
NVD_API_KEY=

# Общий секрет с Worker'ом сайта (статус сборщика, рассылка push). Тот же, что в `wrangler secret put DISPATCH_TOKEN`.
DISPATCH_TOKEN=

# Публикация на сайт: true — тексты публикуются; пусто — только сбор и тексты (сухой режим)
PUBLISH_ENABLED=true

# Деплой сайта с сервера (Cloudflare: Workers Scripts Edit, D1 Edit, Workers Routes Edit, Account Settings Read)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Оповещения владельцу в Telegram (можно тот же бот, что у ТУТ.DUS)
TG_BOT_TOKEN=
TG_CHAT_ID=
