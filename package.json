{
  "name": "secure",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd site && npx astro build",
    "dev": "wrangler dev",
    "check": "tsc -p worker --noEmit && cd site && npx astro check",
    "db:migrate:local": "wrangler d1 migrations apply secure-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply secure-db --remote",
    "deploy": "npm run build && wrangler d1 migrations apply secure-db --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.164.0"
  }
}
