---
import Base from '../../layouts/Base.astro';
import { articlePath, eventsIn } from '../../lib/events';
import { fmtDate } from '../../lib/format';
import { LANGS, LOCALE, t, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const events = await eventsIn(lang);
const months = new Map<string, typeof events>();
for (const e of events) {
  const k = e.dates.published.slice(0, 7);
  months.set(k, [...(months.get(k) ?? []), e]);
}
const monthName = (k: string) =>
  new Intl.DateTimeFormat(LOCALE[lang], { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${k}-01T00:00:00Z`));
---

<Base lang={lang} title={t(lang, 'archive.title')}>
  <div class="wrap page">
    <h1>{t(lang, 'archive.title')}</h1>
    <p class="muted">{t(lang, 'archive.intro')}</p>
    {
      [...months.entries()].map(([k, list]) => (
        <section class="archive-month">
          <h2 id={`m-${k}`}>{monthName(k)}</h2>
          <ul class="archive-list">
            {list.map((e) => (
              <li>
                <time class="mono muted" datetime={e.dates.published}>{fmtDate(e.dates.published)}</time>
                <span class={`flag flag-${e.priority}`}>{t(lang, `prio.${e.priority}`)}</span>
                <a href={articlePath(e, lang)}>{e.translations[lang].title}</a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
